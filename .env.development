# 页面标题
VITE_APP_TITLE = MineAdmin
# 端口
VITE_APP_PORT = 2888
# 应用根路径
VITE_APP_ROOT_BASE = /
# 接口请求地址，会设置到 axios 的 baseURL 参数上
VITE_APP_API_BASEURL = http://127.0.0.1:9501
# 路由模式: history 和 hash 两种，默认hash，带#号那种
VITE_APP_ROUTE_MODE = hash

# 存储前缀
VITE_APP_STORAGE_PREFIX = mine_

# 是否开启代理
VITE_OPEN_PROXY = true
# 代理前缀标识
VITE_PROXY_PREFIX = /dev
# 是否开启开发者工具
VITE_OPEN_DEVTOOLS = false

# 加解密开关：app/Http 下一个目录 = 一个模块，一个模块一个开关（与后端 CRYPT_ENABLED_<MODULE> 一致）
# 其它对外接口（/api/*）
VITE_CRYPT_ENABLED_API = true
# 后台模块（app/Http/Admin → /admin/*）：前端 useHttp 还未接入解密，保持关闭
VITE_CRYPT_ENABLED_ADMIN = false
# 密钥池（base64 的 32 字节，会随产物分发、不是服务端秘密）：必须与后端 crypto.keys 对应项一致
# 各模块密钥按需填写；具名密钥没配时 requestApi 会直接报错（不回退主密钥）
# 主密钥（业务层加密字段用；后台/接口一般不直接用，留空即可）
VITE_PAYLOAD_CIPHER_KEY =
VITE_PAYLOAD_CIPHER_KEY_API = PmKXFaMYtu65J6GGEWrmGeE0uet9QsTVqp8OwNWmsB0=
# 模块独立密钥（按需启用）：名称要与后端 crypto.keys.channel 一致
# 后端 crypto.rules 里给某路径配了 key: channel 时，前端 requestApi 传 cryptoKey: 'channel'
# 并在这里填同一把密钥；不启用独立密钥时留空即可（传 cryptoKey: 'channel' 会直接报错提醒）
VITE_PAYLOAD_CIPHER_KEY_ADMIN =
VITE_PAYLOAD_CIPHER_KEY_CHANNEL =
VITE_PAYLOAD_CIPHER_KEY_LANDING =
# 密文头部标识（版本号），必须与后端 PAYLOAD_CIPHER_MAGIC 一致
VITE_PAYLOAD_CIPHER_MAGIC = PAY1

# OBS 图片解密（与后端 OBS_CONTENT_KEY 一致；真实值写 .env.*.local，已 gitignore）
VITE_OBS_CONTENT_KEY =
# 允许解密的图片来源（OBS 桶地址或 CDN 域名，逗号分隔）
VITE_OBS_IMAGE_ORIGINS =
